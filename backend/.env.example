# Deployment: put the complete JSON in your host's secret environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local alternative: path relative to backend/ or an absolute path.
FIREBASE_CREDENTIALS_PATH=

# Comma-separated deployed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_DEMO_AUTH=false

# Free-plan chat protection.
MESSAGE_DAILY_LIMIT=100
MESSAGE_MAX_LENGTH=2000
MESSAGE_HISTORY_LIMIT=100
